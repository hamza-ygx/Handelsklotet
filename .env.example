# Server-side (Vercel project env vars). One of these:
# Nile Postgres (set automatically by the Vercel Nile integration)
NILEDB_POSTGRES_URL=postgres://<region>.db.thenile.dev:5432/<db>
NILEDB_USER=<user>
NILEDB_PASSWORD=<password>
# ...or any Postgres: POSTGRES_URL=postgres://user:pass@host:5432/db
# ...or Upstash Redis: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (or KV_REST_API_URL / KV_REST_API_TOKEN)

# Client-side. Room/channel name. Use something hard to guess so outsiders can't drive the screen.
VITE_ROOM=main
